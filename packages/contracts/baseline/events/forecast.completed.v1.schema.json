{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/events/forecast.completed.v1",
  "title": "ForecastCompleted",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "forecast.completed.v1"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "input_hash",
        "eligible_count"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_hash": {
          "type": "string"
        },
        "eligible_count": {
          "type": "integer"
        }
      },
      "description": "Document stored at payload_ref.uri; the envelope sha256 covers its bytes."
    }
  }
}
