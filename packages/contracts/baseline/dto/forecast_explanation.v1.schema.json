{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/forecast_explanation.v1",
  "title": "ForecastExplanation",
  "description": "Why a forecast is what it is (feature 018): the model, dataset and configuration versions, the demand class and method, censored and anomalous days, provenance mix, range, confidence and eligibility. Low, expected and high are null when the product is not eligible: no forecast figure exists then.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "sku",
    "model_version",
    "method",
    "method_reason_code",
    "provenance_mix",
    "eligibility",
    "eligibility_reason_codes",
    "confidence_reason_codes"
  ],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "sku": { "type": "string", "minLength": 1, "maxLength": 60 },
    "model_version": { "type": "string", "maxLength": 120 },
    "dataset_version_id": { "type": ["string", "null"], "maxLength": 36 },
    "config_version_id": { "type": ["string", "null"], "maxLength": 36 },
    "history_start": { "type": ["string", "null"], "format": "date" },
    "history_end": { "type": ["string", "null"], "format": "date" },
    "abc": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
    "xyz": { "type": ["string", "null"], "enum": ["X", "Y", "Z", null] },
    "pattern": { "type": ["string", "null"], "maxLength": 14 },
    "intermittent": { "type": "boolean" },
    "method": { "type": "string", "maxLength": 30 },
    "method_reason_code": { "type": "string", "maxLength": 40 },
    "censored_days": { "type": "integer", "minimum": 0 },
    "anomaly_days_excluded": { "type": "integer", "minimum": 0 },
    "provenance_mix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed": { "type": "integer", "minimum": 0 },
        "estimated": { "type": "integer", "minimum": 0 },
        "manual": { "type": "integer", "minimum": 0 }
      }
    },
    "low": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "expected": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "high": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "confidence": { "enum": ["alta", "media", "baja", null] },
    "confidence_reason_codes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 40 }
    },
    "eligibility": {
      "enum": ["eligible", "manual_review_only", "not_eligible"]
    },
    "eligibility_reason_codes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 40 }
    }
  }
}
