{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/proposal_detail.v1",
  "title": "ProposalDetail",
  "description": "Response of GET /api/proposals/{proposal_id} as the web app reads it. Amounts are decimal strings. A separate schema from proposal.v1 because proposal.v1 types money as an object and this response returns strings; retyping proposal.v1 would break its baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "week", "status", "version", "lines"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "status": { "enum": ["draft", "submitted", "approved", "exported", "superseded"] },
    "version": { "type": "integer", "minimum": 1 },
    "created_by": { "type": ["string", "null"] },
    "last_edited_by": { "type": ["string", "null"] },
    "inputs_hash": { "type": ["string", "null"] },
    "rule_versions": { "type": ["object", "null"] },
    "solver_status": { "type": ["string", "null"] },
    "flags": { "type": ["object", "null"], "description": "Internal flags; the web app reads over_budget and review_notes instead" },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "approver": { "type": "string" },
        "decision": { "type": "string" },
        "version": { "type": "integer" },
        "valid": { "type": "boolean" }
      }
    },
    "over_budget": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Euros by which the proposal exceeds the budget cap; 0 when within it. Decimal as string"
    },
    "review_notes": {
      "type": "array",
      "description": "Needed products the plan could not source (FR-014)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "variant_id"],
        "properties": {
          "code": { "enum": ["no_eligible_supplier"] },
          "variant_id": { "type": "integer", "minimum": 1, "description": "For the web app's lookups only; never displayed (users see the SKU)" },
          "sku": { "type": ["string", "null"] },
          "product_name": { "type": ["string", "null"] }
        }
      }
    },
    "terms_version_ids": {},
    "policy_version_ids": {},
    "dataset_version_id": {},
    "forecast_run_id": {},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "variant_id", "supplier_id", "qty", "unit_cost_with_recargo", "line_total"],
        "properties": {
          "id": { "type": "string" },
          "variant_id": { "type": "integer", "minimum": 1 },
          "product_id": { "type": ["integer", "null"] },
          "supplier_id": { "type": "string" },
          "qty": { "type": "integer", "minimum": 0 },
          "sku": { "type": ["string", "null"] },
          "product_name": { "type": ["string", "null"] },
          "supplier_name": { "type": ["string", "null"] },
          "unit_cost_with_recargo": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
          "line_total": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
          "forecast_or_policy": {},
          "safety_stock": {},
          "constraints_applied": {},
          "risk": {},
          "confidence": {},
          "explanation": {},
          "alternatives_compared": {},
          "manual_override": {},
          "topup": {}
        }
      }
    },
    "supplier_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supplier_id": { "type": "string" },
          "supplier_name": { "type": ["string", "null"] },
          "subtotal": { "type": "string" },
          "discount": { "type": "string" },
          "delivery_charge": { "type": "string" },
          "total_cost": { "type": "string" },
          "expected_delivery_date": { "type": ["string", "null"] },
          "minimum_status": {},
          "free_delivery": {},
          "shortfall_options": {}
        }
      }
    }
  }
}
