{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/policy_set.v1",
  "title": "PolicySet",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "key", "valid_from", "revision"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "enum": ["global", "segment", "product"]
    },
    "key": {
      "type": "string"
    },
    "service_level": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "safety_stock_units": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "min_units": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "max_units": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "replenishment_cadence_days": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic-concurrency revision; PUT requires If-Match with this value"
    },
    "changed_by": {
      "type": "string"
    }
  },
  "description": "Purchase policy values for a scope. Rule: max_units >= min_units; service_level in 0..1."
}
