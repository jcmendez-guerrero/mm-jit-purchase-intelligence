{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/events/inventory.rules.changed.v1",
  "title": "InventoryRulesChanged",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "inventory.rules.changed.v1"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exclusion",
            "censoring"
          ]
        },
        "variant_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Demand exclusions or censoring rules changed."
    }
  }
}
