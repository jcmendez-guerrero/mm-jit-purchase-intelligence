      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "supplier_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "description": "Document stored at payload_ref.uri; the envelope sha256 covers its bytes."
    }
  }
