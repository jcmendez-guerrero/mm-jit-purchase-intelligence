{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/seed_dataset.v1",
  "title": "SeedDataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "origin", "file_sha256"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "uploaded",
        "validated",
        "approved",
        "active",
        "superseded",
        "rolled_back",
        "rejected"
      ]
    },
    "origin": {
      "enum": ["synthetic", "real"]
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uploader": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_by": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "activated_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "validated_by": {
      "oneOf": [{ "type": "string" }, { "type": "null" }],
      "description": "Who ran validation; with the uploader, cannot approve activation (MMI-7)."
    },
    "mapping_chosen_by": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "rollback_reason_code": {
      "oneOf": [
        {
          "enum": [
            "wrong_figures",
            "wrong_file",
            "test",
            "replaced_by_newer",
            "other"
          ]
        },
        { "type": "null" }
      ],
      "description": "Why an active dataset was rolled back (FR-033). The code is shown to everyone and recorded in the audit trail."
    },
    "rollback_reason_detail": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }],
      "description": "Short free-text detail. Returned to admins only; never written to the audit trail."
    },
    "self_activation_reason_code": {
      "oneOf": [
        { "enum": ["only_person", "urgent", "other"] },
        { "type": "null" }
      ],
      "description": "Set only for an audited owner/admin self-activation."
    },
    "self_activation_reason_detail": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }],
      "description": "Short free-text detail. Returned to admins only; never written to the audit trail."
    },
    "row_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "quarantined", "rejected"],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "description": "A dataset cannot mix origins; imported data is never an ERP movement."
}
