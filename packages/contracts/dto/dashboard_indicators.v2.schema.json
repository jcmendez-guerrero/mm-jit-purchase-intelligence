{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/dashboard_indicators.v2",
  "title": "DashboardIndicators",
  "description": "Executive dashboard indicators (feature 006): ten indicators with freshness, state and an optional breakdown, plus the drill-down page and chart series shapes. Added beside dashboard_summary.v1, which is untouched.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filters",
    "indicators"
  ],
  "properties": {
    "filters": {
      "$ref": "#/$defs/FilterSet"
    },
    "indicators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Indicator"
      }
    }
  },
  "$defs": {
    "FilterSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date_from",
        "date_to"
      ],
      "properties": {
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "warehouse_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "supplier_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 36
        },
        "category": {
          "enum": [
            "A",
            "B",
            "C",
            "critical",
            null
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "DataFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "origin",
        "state"
      ],
      "properties": {
        "source": {
          "enum": [
            "inventory_snapshot",
            "movements",
            "forecast",
            "accuracy",
            "budget_spend"
          ]
        },
        "refreshed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "refreshed_at_original": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "erp_sync",
            "local_load",
            "forecast",
            "proposal"
          ]
        },
        "state": {
          "enum": [
            "ok",
            "no_data",
            "stale",
            "error"
          ]
        },
        "stale_after_hours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "unit",
        "state",
        "basis",
        "definition_key",
        "freshness"
      ],
      "properties": {
        "key": {
          "enum": [
            "stock_value",
            "coverage_days",
            "demand",
            "forecast",
            "stockout_risk",
            "expiry_exposure",
            "capital_tied_up",
            "purchasing_budget",
            "wape",
            "bias"
          ]
        },
        "value": {
          "description": "Decimal or integer as a string; null when state is not ok",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "unit": {
          "enum": [
            "EUR",
            "days",
            "units",
            "count",
            "percent"
          ]
        },
        "state": {
          "enum": [
            "ok",
            "no_data",
            "stale",
            "error",
            "hidden_by_role"
          ]
        },
        "basis": {
          "type": "string"
        },
        "definition_key": {
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/DataFreshness"
        },
        "incomplete_count": {
          "type": "integer",
          "minimum": 0
        },
        "filters_unsupported": {
          "type": "array",
          "items": {
            "enum": [
              "date",
              "warehouse",
              "supplier",
              "category",
              "family"
            ]
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        }
      }
    },
    "ContributionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "sku",
        "name",
        "figure"
      ],
      "properties": {
        "variant_id": {
          "type": "integer",
          "description": "Internal id, sent only so the screen can open the product detail; it is never displayed."
        },
        "sku": {
          "type": [
            "string",
            "null"
          ],
          "description": "What users see and supply."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure": {
          "type": [
            "string",
            "null"
          ],
          "description": "The row's contribution as a Decimal string; null for kinds without a figure."
        }
      }
    },
    "DrillPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rows",
        "total",
        "truncated",
        "offset",
        "sum"
      ],
      "properties": {
        "kind": {
          "enum": [
            "inventory_value",
            "coverage",
            "stockout_risk",
            "expiry_risk",
            "abc_xyz",
            "trend_day"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContributionRow"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean",
          "description": "True when more rows follow this page."
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "sum": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Sum of every row (not only this page); equals the card value for the same filters. Null for kinds without a total."
        }
      }
    },
    "ChartSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title_key",
        "columns",
        "rows",
        "state"
      ],
      "properties": {
        "key": {
          "enum": [
            "demand_forecast",
            "abc_xyz",
            "expiry_bands",
            "coverage_buckets",
            "capital_by_group",
            "forecast_error",
            "stock_value_history"
          ]
        },
        "title_key": {
          "type": "string"
        },
        "summary_params": {
          "type": "object"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "range_available": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "state": {
          "enum": [
            "ok",
            "no_data",
            "error"
          ]
        }
      }
    },
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label_key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label_key": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    }
  }
}
