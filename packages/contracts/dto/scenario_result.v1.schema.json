{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/scenario_result.v1",
  "title": "ScenarioResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "supplier_id", "order_total", "lines"],
  "properties": {
    "scenario_id": {
      "type": "string",
      "format": "uuid"
    },
    "supplier_id": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "description": "Contract shape of an order line. The procurement read model GET /scenarios/{id} sends qty, line_total and clinical_critical instead of quantity, so only sku and name are shared with it. Only the response summary is validated against a schema, in services/procurement-service/tests/test_scenarios_api.py; the lines are checked field by field.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "quantity", "unit_cost"],
        "properties": {
          "variant_id": {
            "type": "integer",
            "minimum": 1
          },
          "sku": {
            "type": ["string", "null"],
            "minLength": 1,
            "description": "Catalogue SKU of the product at read time; null when it cannot be resolved. People see this, never variant_id."
          },
          "name": {
            "type": ["string", "null"],
            "minLength": 1,
            "description": "Catalogue product name at read time; lets rows without a SKU be told apart."
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "unit_cost": {
            "$ref": "money.v1.schema.json"
          },
          "discount": {
            "oneOf": [
              {
                "$ref": "money.v1.schema.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "shipping": {
            "oneOf": [
              {
                "$ref": "money.v1.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "order_total": {
      "$ref": "money.v1.schema.json"
    },
    "subtotal": {
      "oneOf": [{ "$ref": "money.v1.schema.json" }, { "type": "null" }]
    },
    "delivery_charge": {
      "oneOf": [{ "$ref": "money.v1.schema.json" }, { "type": "null" }]
    },
    "discount": {
      "oneOf": [{ "$ref": "money.v1.schema.json" }, { "type": "null" }]
    },
    "free_delivery": {
      "type": ["boolean", "null"]
    },
    "expected_delivery": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_utilisation": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    }
  }
}
