{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/demand_rule.v1",
  "title": "DemandRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "revision"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": ["exclusion", "censoring"]
    },
    "variant_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "from_day": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "to_day": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Superseded by reason_code (feature 011): older rows may hold free text, which is never copied to the audit"
    },
    "sku": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ],
      "description": "What people see and type for an exclusion (null = every product); the ERP variant id stays inside the platform"
    },
    "reason_code": {
      "enum": ["promotion", "closure", "supplier_outage", "bulk_sale", "other"],
      "description": "Pick-list reason; the only reason text the audit trail carries"
    },
    "detail": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ],
      "description": "Short optional detail, shown to admins only and never written to the audit trail"
    },
    "rule": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic-concurrency revision; PUT requires If-Match with this value"
    },
    "changed_by": {
      "type": "string"
    }
  },
  "description": "Demand exclusion (days excluded from forecasting, reversible) or stockout-censoring rule parameter."
}
