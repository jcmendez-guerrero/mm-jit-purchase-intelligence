{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/demand_rule.v1",
  "title": "DemandRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "revision"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": ["exclusion", "censoring"]
    },
    "variant_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "from_day": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "to_day": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "rule": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic-concurrency revision; PUT requires If-Match with this value"
    },
    "changed_by": {
      "type": "string"
    }
  },
  "description": "Demand exclusion (days excluded from forecasting, reversible) or stockout-censoring rule parameter."
}
