{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmi/dto/conditions_block.v1",
  "title": "ConditionsBlock",
  "description": "App-owned supplier conditions mirrored in the ERP note (disabled until Gate 0). Money is a decimal string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "order_days", "currency", "updated", "hash"],
  "properties": {
    "v": { "const": 1 },
    "lead_time_days": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 365 },
        { "type": "null" }
      ]
    },
    "min_order_value": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" },
        { "type": "null" }
      ]
    },
    "min_qty": {
      "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
    },
    "free_delivery_threshold": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" },
        { "type": "null" }
      ]
    },
    "delivery_charge": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" },
        { "type": "null" }
      ]
    },
    "order_days": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 7 },
      "uniqueItems": true
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "updated": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
