{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureStatusAudit",
  "type": "object",
  "required": ["audited_commit", "audited_at", "features"],
  "additionalProperties": false,
  "properties": {
    "audited_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "audited_at": { "type": "string", "format": "date-time" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidence", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["complete", "partial", "broken", "missing", "unverified"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[^:\\s]+:[0-9]+$", "description": "path:line" }
          },
          "owner": { "type": "string" },
          "reuse": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
